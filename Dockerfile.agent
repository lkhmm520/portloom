# syntax=docker/dockerfile:1.7

# Keep this version and multi-platform digest in sync with go.mod.
FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN expected="go$(awk '$1 == "go" {print $2}' go.mod)" \
    && actual="$(go env GOVERSION)" \
    && { [ "$actual" = "$expected" ] || { echo "Go toolchain mismatch: expected $expected, found $actual" >&2; exit 1; }; } \
    && go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -buildvcs=false -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o /out/portloom-agent ./cmd/agent

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssh-client tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 tunnel \
    && useradd -u 65532 -g tunnel -d /home/tunnel -m -s /usr/sbin/nologin tunnel \
    && install -d -o tunnel -g tunnel /data /home/tunnel/.ssh
COPY --from=build /out/portloom-agent /usr/local/bin/portloom-agent
USER tunnel
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/portloom-agent"]
